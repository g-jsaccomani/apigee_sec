# Environment configuration template for API Security Posture Review (API-SPR)
# Copy this file to .env and adjust values for your environment.

# Execution environment mode: local, dev, staging, prod
# When set to 'local', the backend operates with realistic mock data and local fallback responses.
ANTIGRAVITY_ENV=local

# Google Cloud Project ID
GCP_PROJECT_ID=your-project-id

# Google Cloud Apigee Organization ID and Environment
APIGEE_ORG_ID=your-org-id
APIGEE_ENV=eval

# Minimum flag duration in hours before transitioning security actions from Flag to Deny
FLAG_DURATION_HOURS=72

# Port on which the application server listens
PORT=8080
